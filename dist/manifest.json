{
  "manifest_version": 3,
  "name": "求职 Copilot · 华为简历助手",
  "version": "0.2.2",
  "description": "本地保存纯文字简历内容库，读取华为招聘当前页面并填写明确匹配字段，由你检查并提交。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["https://career.huawei.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "action": {"default_title": "打开求职 Copilot", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png"}},
  "side_panel": {"default_path": "index.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"}
}
